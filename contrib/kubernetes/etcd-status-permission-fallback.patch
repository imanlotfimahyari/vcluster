 func (f *defaultFeatureSupportChecker) clientSupportsRequestWatchProgress(ctx context.Context, c client, ep string) error {
 	supported, err := endpointSupportsRequestWatchProgress(ctx, c, ep)
 	if err != nil {
-		return err
+		if status.Code(err) != codes.PermissionDenied && !errors.Is(err, rpctypes.ErrPermissionDenied) {
+			return err
+		}
+		// Status is an administrator operation in authenticated etcd. A client
+		// restricted to a Kubernetes key range can still serve ordinary storage
+		// requests. Treat an unavailable capability check conservatively instead
+		// of retrying an authorization failure forever or requiring broader access.
+		klog.InfoS("etcd Status is not authorized; disabling RequestWatchProgress optimization", "endpoint", ep)
+		supported = false
 	}
 	f.lock.Lock()
 	defer f.lock.Unlock()
