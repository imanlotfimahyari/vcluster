+
+func TestStatusPermissionDeniedDisablesOptimizationWithoutRetry(t *testing.T) {
+	for _, denial := range []error{rpctypes.ErrPermissionDenied, status.Error(codes.PermissionDenied, "etcdserver: permission denied"), fmt.Errorf("wrapped: %w", rpctypes.ErrPermissionDenied)} {
+		checker := newDefaultFeatureSupportChecker()
+		checker.progressNotifySupported = new(bool)
+		*checker.progressNotifySupported = true
+		mock := &MockEtcdClient{EndpointVersion: []mockEndpointVersion{{Endpoint: "test", Error: denial}}}
+		if err := checker.clientSupportsRequestWatchProgress(context.Background(), mock, "test"); err != nil {
+			t.Fatalf("authorization failure would be retried: %v", err)
+		}
+		if checker.Supports(storage.RequestWatchProgress) {
+			t.Fatal("unverified capability was enabled")
+		}
+	}
+}
+
+func TestStatusTransientFailureStillRetries(t *testing.T) {
+	checker := newDefaultFeatureSupportChecker()
+	mock := &MockEtcdClient{EndpointVersion: []mockEndpointVersion{{Endpoint: "test", Error: status.Error(codes.Unavailable, "transient")}}}
+	if err := checker.clientSupportsRequestWatchProgress(context.Background(), mock, "test"); err == nil {
+		t.Fatal("transient failure was treated as a terminal capability decision")
+	}
+}
